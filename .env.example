# Protogate Server Configuration
# Copy this to .env and adjust values for your environment

# Server Ports
PORT=8080                    # HTTP proxy port for tunnel traffic
AGENT_PORT=8443              # TLS port for agent connections
TCP_PORTS=9100               # Comma-separated TCP ports to expose (optional)

# Azure Key Vault (required format: https://<name>.vault.azure.net)
KEY_VAULT_URI=https://mock.vault.azure.net

# DNS Configuration (required format: valid domain name with dot)
DNS_ZONE=tunnel.local

# Azure Monitoring (optional but recommended)
LOG_ANALYTICS_WORKSPACE_ID=mock-id
AZURE_STORAGE_CONNECTION_STRING=mock

# Token Configuration
TOKEN_TYPE=mock              # Use "mock" for local testing
TUNNEL_ID=test-api           # For agent authentication

# Local Testing Quick Start:
# 1. Start test HTTP server: cd /tmp && python3 -m http.server 3000 &
# 2. Start protogate-server with above env vars
# 3. Start tunnel-agent:
#    ./build/tunnel-agent \
#      --server-host localhost \
#      --server-port 8443 \
#      --tunnel-id test-api \
#      --token tnl_local_test_123 \
#      --target-host localhost \
#      --target-port 3000 \
#      --no-verify-tls
# 4. Test TCP tunnel:
#    (echo -e "GET / HTTP/1.0\r\n\r\n"; sleep 2) | nc localhost 9100
#
# NOTE: macOS does NOT have 'timeout' command - use 'gtimeout' (brew install coreutils)
#       or use pattern: (echo "data"; sleep N) | nc host port

# BUILD SYSTEM REFERENCE (prevents costly mistakes)
# ===================================================
# This project uses CMAKE, NOT Cargo/Rust
# 
# Build commands (run from repo root):
#   Full build:    cmake --build build -j$(sysctl -n hw.ncpu)
#   Server only:   cmake --build build --target protogate-server
#   Agent only:    cmake --build build --target tunnel-agent
#
# Binary locations (after build):
#   Server: /Volumes/Projects/protogate/build/protogate-server
#   Agent:  /Volumes/Projects/protogate/build/tunnel-agent
#
# CRITICAL: Always use ABSOLUTE PATHS for scripts and binaries
#   ✅ CORRECT:   /Volumes/Projects/protogate/start-server-local.sh
#   ❌ WRONG:     ./start-server-local.sh  (breaks if CWD is wrong)
#
#   ✅ CORRECT:   /Volumes/Projects/protogate/build/tunnel-agent
#   ❌ WRONG:     ./build/tunnel-agent  (breaks if CWD is wrong)
#   ❌ WRONG:     ./target/release/tunnel-agent  (THIS IS NOT RUST!)
