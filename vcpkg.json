{
  "name": "protogate",
  "version": "1.0.0",
  "description": "High-performance reverse tunneling server for HTTP/HTTPS and TCP traffic",
  "homepage": "https://github.com/ormasoftchile/protogate",
  "license": "MIT",
  "dependencies": [
    {
      "name": "boost-asio",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-system",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-thread",
      "version>=": "1.82.0"
    },
    {
      "name": "openssl",
      "version>=": "3.0.0"
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.0"
    },
    {
      "name": "gtest",
      "version>=": "1.13.0"
    },
    {
      "name": "benchmark",
      "version>=": "1.8.0"
    }
  ],
  "builtin-baseline": "latest",
  "features": {
    "tests": {
      "description": "Enable testing support",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmarks": {
      "description": "Enable performance benchmarks",
      "dependencies": [
        "benchmark"
      ]
    }
  }
}
