# Multi-stage Dockerfile for Protogate Server (ARM64/x86_64)
# Stage 1: Builder with all build dependencies

FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS builder

# Build arguments for cross-platform support
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG CACHEBUST=1

# Force cache bust
RUN echo "Cache bust: ${CACHEBUST}"

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    zip \
    unzip \
    tar \
    pkg-config \
    libssl-dev \
    libnghttp2-dev \
    libboost-system-dev \
    libboost-thread-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    libbenchmark-dev \
    && rm -rf /var/lib/apt/lists/*

# Boost.Asio is header-only, included with libboost-system-dev
# No vcpkg needed - using system packages

ENV VCPKG_ROOT=/opt/vcpkg
ENV PATH="${VCPKG_ROOT}:${PATH}"

# Copy source code
WORKDIR /src
COPY CMakeLists.txt ./
COPY src/ ./src/

# Build the project (static linking for Alpine compatibility)
# Remove any existing build directory to force complete rebuild
RUN rm -rf build && \
    cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    && cmake --build build --target protogate-server --parallel $(nproc)

# Stage 2: Minimal runtime image based on Ubuntu (for glibc compatibility)
FROM ubuntu:22.04

# Install runtime dependencies only  
RUN apt-get update && apt-get install -y \
    libssl3 \
    libnghttp2-14 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 protogate && \
    useradd -r -u 1000 -g protogate protogate

# Copy binary from builder
COPY --from=builder /src/build/protogate-server /usr/local/bin/protogate-server
RUN chmod +x /usr/local/bin/protogate-server

# Switch to non-root user
USER protogate

# Expose ports
EXPOSE 443 8080 8443

# Health check (use HTTP on port 8080)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Set environment defaults
ENV PORT=443
ENV AGENT_PORT=8443

# Run the server
ENTRYPOINT ["/usr/local/bin/protogate-server"]
